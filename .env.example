# Never commit real credentials. Generate the Memory System Key yourself and
# submit it only through the competition's controlled application flow.
TIDE_MEMORY_API_KEY=replace-with-a-long-random-memory-system-key
TIDE_LLM_API_KEY=replace-with-your-provider-key

# Challenge-fixed model configuration.
TIDE_LLM_API_BASE=https://api.openai.com/v1
TIDE_LLM_MODEL=gpt-4o-mini
TIDE_ENFORCE_GPT4O_MINI=true
TIDE_LLM_MODE=api
TIDE_LLM_REQUIRED=true

# Persistent state and privacy retention.
TIDE_DB_PATH=/data/tide_mem.sqlite3
TIDE_TTL_DAYS=30
TIDE_TTL_CLEANUP_INTERVAL_SECONDS=21600

# Capacity. Tune the upstream concurrency to match your provider quota.
TIDE_LLM_MAX_CONCURRENCY=16
TIDE_LLM_TIMEOUT_SECONDS=120
TIDE_LLM_MAX_RETRIES=5

# Memory construction and retrieval.
TIDE_MAX_CARDS_PER_ADD=24
TIDE_MAX_SUMMARY_CARDS_PER_ADD=4
TIDE_RETRIEVAL_CANDIDATE_LIMIT=220
TIDE_RERANK_CANDIDATE_LIMIT=80
TIDE_RETURNED_CONTENT_MAX_CHARS=1800

TIDE_REQUIRE_AUTH=true
TIDE_LOG_LEVEL=INFO
